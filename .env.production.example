# =============================================
# お菓子のみよしや LP - 本番環境設定テンプレート
# このファイルを .env.production にコピーして使用
# =============================================

# データベース（docker-compose.prod.yml が自動設定するので基本変更不要）
DB_USER=sweets
DB_PASSWORD=ここに強いパスワードを設定（例: xK9mP2qR7nL5）

# 管理画面パスワード（必ず変更する）
ADMIN_PASSWORD=ここに管理者パスワードを設定

# サイトURL（VPSのIPアドレスまたはドメイン）
NEXT_PUBLIC_SITE_URL=http://VPSのIPアドレス:3000
# ドメイン取得後: https://example.com
